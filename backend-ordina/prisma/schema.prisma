generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id                  Int        @id @default(autoincrement())
  email               String     @unique
  passwordHash        String     @map("password_hash")
  displayName         String     @map("display_name")
  age                 Int?
  gender              String?
  goals               String?
  provider            String     @default("local")
  googleId            String?    @unique @map("google_id")
  appleId             String?    @unique @map("apple_id")
  onboardingCompleted Boolean    @default(false) @map("onboarding_completed")
  themePreference     String     @default("light") @map("theme_preference")
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")
  tasks               Task[]
  categories          Category[]
  projects            Project[]

  @@map("users")
}

model Task {
  id          Int            @id @default(autoincrement())
  userId      Int            @map("user_id")
  title       String
  description String?
  status      TaskStatus     @default(pending)
  priority    String         @default("medium")
  category    String         @default("work")
  projectId   Int?           @map("project_id")
  dueAt       DateTime?      @map("due_at")
  startTime   String?        @map("start_time")
  endTime     String?        @map("end_time")
  duration    String?
  reminder    Boolean        @default(false)
  completedAt DateTime?      @map("completed_at")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  project     Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  categories  TaskCategory[]

  @@index([userId])
  @@index([userId, status])
  @@index([dueAt])
  @@map("tasks")
}

model Category {
  id        Int            @id @default(autoincrement())
  userId    Int            @map("user_id")
  name      String
  color     String?
  createdAt DateTime       @default(now()) @map("created_at")
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks     TaskCategory[]

  @@unique([userId, name])
  @@index([userId])
  @@map("categories")
}

model TaskCategory {
  taskId     Int      @map("task_id")
  categoryId Int      @map("category_id")
  createdAt  DateTime @default(now()) @map("created_at")
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([taskId, categoryId])
  @@index([categoryId])
  @@map("task_categories")
}

model Project {
  id             Int      @id @default(autoincrement())
  userId         Int      @map("user_id")
  name           String
  subtitle       String?
  progress       Int      @default(0)
  color          String   @default("#8B5CF6")
  tasksTotal     Int      @default(0) @map("tasks_total")
  tasksCompleted Int      @default(0) @map("tasks_completed")
  tasksOverdue   Int      @default(0) @map("tasks_overdue")
  dueDate        DateTime? @map("due_date")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks          Task[]

  @@index([userId])
  @@map("projects")
}

enum TaskStatus {
  pending
  in_progress
  completed
  archived
}
