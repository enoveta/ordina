# SQLite
DATABASE_URL="file:./data/ordina.sqlite"

PORT=4000
NODE_ENV=development
JWT_SECRET="replace-with-a-long-random-secret"
CORS_ORIGIN="*"

# Backend-only AI key (Phase 6). Never put this in the mobile app.
OPENAI_API_KEY=""

# Google Sign-In: Web client ID used to verify ID tokens from the app.
GOOGLE_CLIENT_ID=""

# Apple Sign-In: Services ID / bundle ID used to identify Apple tokens.
APPLE_CLIENT_ID=""
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
