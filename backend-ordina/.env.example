DATABASE_URL="file:./data/ordina.sqlite"
PORT=4000
JWT_SECRET="replace-with-a-long-random-secret"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"

# Same Web client ID as EXPO_PUBLIC_GOOGLE_CLIENT_ID (required for Google sign-in)
GOOGLE_CLIENT_ID=""
GOOGLE_IOS_CLIENT_ID=""
GOOGLE_ANDROID_CLIENT_ID=""

# iOS bundle id or Apple Services ID (required for Sign in with Apple)
APPLE_CLIENT_ID=""
APPLE_BUNDLE_ID="com.ordina.app"

# Optional. If unset, forgot-password returns the 6-digit code in the API response for in-app reset.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
SMTP_SECURE="false"
