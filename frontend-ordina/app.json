{
  "expo": {
    "name": "ORDINA",
    "slug": "ordina",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/ordina-logo.png",
    "scheme": "ordina",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/ordina-logo.png",
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/ordina-logo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/ordina-logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/images/ordina-logo.png",
          "imageWidth": 200
        }
      ],
      "expo-secure-store",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
